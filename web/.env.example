# Copy to .env and configure locally. Never commit real keys.
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_MODEL=deepseek-v3-1-250821
# Optional stable Flask secret; otherwise a fresh value is generated at startup.
AI4EDA_SECRET_KEY=
YOSYS_PATH=yosys
AI4EDA_HOST=127.0.0.1
AI4EDA_PORT=5000
AI4EDA_DEBUG=0
# Gunicorn uses port 8080 independently of the development server.
AI4EDA_BIND=127.0.0.1:8080
WEB_CONCURRENCY=2
